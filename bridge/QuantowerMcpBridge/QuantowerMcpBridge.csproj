<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bridge Quantower MCP.

    Compilation isolée (sans Quantower installé — host standalone « stub », Exe net8.0-windows) :
      dotnet build bridge/QuantowerMcpBridge/QuantowerMcpBridge.csproj
      puis lancement du host standalone : options port/token/latency/trading (voir Program.cs).

    Compilation du vrai module Quantower (active le symbole QUANTOWER_SDK, référence le SDK,
    cible net10.0 — les assemblies Quantower v1.146.18 ciblent .NET 10 — et produit une Library
    à déployer dans bin\plug-ins\QuantowerMcpBridge\) :
      dotnet build bridge/QuantowerMcpBridge/QuantowerMcpBridge.csproj -c Release -p:QuantowerSdkDir="C:\Quantower\TradingPlatform\v1.146.18\bin"

    Si une version installée de Quantower cible une autre version de .NET, préciser aussi :
      -p:QuantowerTargetFramework=net8.0 (ou net48 pour un SDK .NET Framework)

    Déploiement (voir bridge/README.md §3) : copier QuantowerMcpBridge.dll (et ses éventuelles
    dépendances privées) vers <QuantowerSdkDir>\plug-ins\QuantowerMcpBridge\ puis redémarrer Quantower.
  -->

  <PropertyGroup>
    <!-- Mode stub : Exe (host standalone Program.cs) ; mode SDK Quantower : Library (module plugin). -->
    <OutputType Condition="'$(QuantowerSdkDir)' == ''">Exe</OutputType>
    <OutputType Condition="'$(QuantowerSdkDir)' != ''">Library</OutputType>

    <!-- Mode stub : net8.0-windows (inchangé) ; mode SDK : net10.0 (les assemblies Quantower
         v1.146.18 ciblent .NET 10 / System.Runtime 10.0.0.0).
         QuantowerTargetFramework reste prioritaire pour les autres SDK (ex. net8.0, net48). -->
    <TargetFramework Condition="'$(QuantowerTargetFramework)' != ''">$(QuantowerTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(QuantowerTargetFramework)' == '' and '$(QuantowerSdkDir)' != ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(QuantowerTargetFramework)' == '' and '$(QuantowerSdkDir)' == ''">net8.0-windows</TargetFramework>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>QuantowerMcpBridge</RootNamespace>
    <AssemblyName>QuantowerMcpBridge</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Quantower MCP Bridge</Product>
    <Description>Plugin Quantower exposant une API HTTP JSON locale (loopback) pour le serveur MCP quantower-mcp-server.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(QuantowerSdkDir)' != ''">
    <DefineConstants>$(DefineConstants);QUANTOWER_SDK</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(QuantowerSdkDir)' != ''">
    <Reference Include="TradingPlatform.BusinessLayer">
      <HintPath>$(QuantowerSdkDir)\TradingPlatform.BusinessLayer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TradingPlatform.PresentationLayer.Plugins">
      <HintPath>$(QuantowerSdkDir)\TradingPlatform.PresentationLayer.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <!-- System.Text.Json n'est pas inclus dans .NET Framework : disponible via NuGet. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
